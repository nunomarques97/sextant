# Sextant environment variables (example).
# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# BACKTEST mode requires NONE of these. The system must start with this file absent.

# --- Live-trading master switch -------------------------------------------------
# Read directly from the process environment. It cannot be set from any YAML file.
# LIVE mode refuses to start unless this is exactly "1".
SEXTANT_ALLOW_LIVE=0

# --- Configuration profile ------------------------------------------------------
# One of: backtest | paper | live. Unset resolves to "backtest".
SEXTANT_PROFILE=backtest

# --- Settings overrides ---------------------------------------------------------
# Any settings key can be overridden with SEXTANT_<SECTION>__<KEY>.
# SEXTANT_RUN__VENUE=kraken
# SEXTANT_LOGGING__LEVEL=DEBUG

# --- Exchange credentials -------------------------------------------------------
# Pattern: SEXTANT_<VENUE>_API_KEY / SEXTANT_<VENUE>_API_SECRET
# Required only when the resolved run needs a credentialed capability
# (account data or any trading capability). Never required in BACKTEST.
# The API key must NOT carry withdrawal permission. Startup aborts if it does.
SEXTANT_KRAKEN_API_KEY=replace-me
SEXTANT_KRAKEN_API_SECRET=replace-me
SEXTANT_BINANCE_API_KEY=replace-me
SEXTANT_BINANCE_API_SECRET=replace-me

# --- LLM analyst ----------------------------------------------------------------
# Not used in SEXTANT-001. No network call to any LLM provider exists yet.
ANTHROPIC_API_KEY=replace-me
