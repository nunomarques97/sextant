# The layering contract. This file is the mechanism that turns "strategies are
# exchange-agnostic" from an intention into an enforced fact. CI fails on violation.
[importlinter]
root_packages =
    sextant
include_external_packages = True

[importlinter:contract:domain-is-pure]
name = domain depends on nothing inside sextant
type = forbidden
source_modules =
    sextant.domain
forbidden_modules =
    sextant.adapters
    sextant.engine
    sextant.app
    sextant.ports

[importlinter:contract:engine-is-abstract]
name = engine never sees a concrete adapter or the wiring layer
type = forbidden
source_modules =
    sextant.engine
forbidden_modules =
    sextant.adapters
    sextant.app

[importlinter:contract:ports-are-abstract]
name = ports never see a concrete adapter
type = forbidden
source_modules =
    sextant.ports
forbidden_modules =
    sextant.adapters
    sextant.app

[importlinter:contract:exchange-sdks-are-quarantined]
name = exchange SDKs may only be imported inside adapters.exchanges
type = forbidden
source_modules =
    sextant.domain
    sextant.ports
    sextant.engine
    sextant.app
    sextant.adapters.storage
    sextant.adapters.llm
    sextant.adapters.clocks
forbidden_modules =
    ccxt
    binance
    python_binance
    krakenex
    pykrakenapi
allow_indirect_imports = False

# httpx needs two contracts rather than one, because `app` is by definition the
# layer that wires concrete adapters to ports. It therefore reaches httpx
# transitively through whichever adapter it builds, and always will. Banning the
# reachable *path* from app would ban the wiring layer from doing its job.
#
# What actually matters is stated as two separate facts:
#   1. domain, ports and engine cannot reach httpx at all, by any path. That is
#      the acceptance criterion, and it is what keeps the engine testable
#      without a network and portable across venues.
#   2. app may not import httpx itself. It may hold an adapter that speaks HTTP;
#      it may not speak HTTP.

[importlinter:contract:http-client-unreachable-from-the-core]
name = domain, ports and engine cannot reach the HTTP client by any path
type = forbidden
source_modules =
    sextant.domain
    sextant.ports
    sextant.engine
    sextant.adapters.storage
    sextant.adapters.llm
    sextant.adapters.clocks
forbidden_modules =
    httpx
allow_indirect_imports = False

[importlinter:contract:http-client-not-spoken-by-the-wiring-layer]
name = app wires adapters that speak HTTP, and never speaks HTTP itself
type = forbidden
source_modules =
    sextant.app
forbidden_modules =
    httpx
allow_indirect_imports = True

# The storage engines get the same two-contract treatment as httpx, and for the
# same reason. `app` is the layer that wires a concrete store to a port, so it
# reaches pyarrow and duckdb transitively through whichever store it builds. The
# acceptance criterion is about the core, and it is stated as two facts:
#
#   1. domain, ports and engine cannot reach either engine at all, by any path.
#      This is what keeps a strategy runnable with no store and no file system.
#   2. app may hold a store that speaks parquet; it may not speak parquet.
#
# See docs/adr/0005-bar-storage-parquet-and-duckdb.md.

[importlinter:contract:storage-engines-unreachable-from-the-core]
name = domain, ports and engine cannot reach the storage engines by any path
type = forbidden
source_modules =
    sextant.domain
    sextant.ports
    sextant.engine
    sextant.adapters.exchanges
    sextant.adapters.llm
    sextant.adapters.clocks
forbidden_modules =
    pyarrow
    duckdb
allow_indirect_imports = False

[importlinter:contract:storage-engines-not-spoken-by-the-wiring-layer]
name = app wires stores that speak parquet, and never speaks parquet itself
type = forbidden
source_modules =
    sextant.app
forbidden_modules =
    pyarrow
    duckdb
allow_indirect_imports = True

[importlinter:contract:venues-are-independent-peers]
name = binance and kraken are peers, not a chain
type = independence
modules =
    sextant.adapters.exchanges.binance
    sextant.adapters.exchanges.kraken
